<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700" prefWidth="1000" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.quentincillierre.hangman.controller.GameController">   
                         <!-- BACKGROUND -->
    <ImageView fx:id="backgroundImage" fitHeight="811.0" fitWidth="1312.0" layoutX="-10.0" layoutY="-6.0" preserveRatio="false" />
         
         
         
         
             <!-- LIVES -->

             <ImageView fx:id="livesPanelImage" fitHeight="149.0" fitWidth="241.0" layoutX="24.0" layoutY="211.0" preserveRatio="true" />

      
      
      
      
      
          <!-- HINT MESSAGE -->

          <Label fx:id="hintLabel" layoutX="270" layoutY="510" prefWidth="400" style="            -fx-font-size:18;            -fx-font-weight:bold;            -fx-text-fill:#1E4E79;" wrapText="true" />

   <ImageView fx:id="pauseButtonImage" fitHeight="113.0" fitWidth="221.0" layoutX="1040" layoutY="185.0" pickOnBounds="true" preserveRatio="true" />


    <!-- KEYBOARD -->

    <GridPane fx:id="keyboardGrid" hgap="8" layoutX="260.0" layoutY="576.0" prefHeight="180" prefWidth="720" vgap="8">
      <columnConstraints>
         <ColumnConstraints />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints />
      </rowConstraints></GridPane>

   
   
       <Label fx:id="livesLabel" alignment="CENTER" layoutX="37.0" layoutY="251.0" prefHeight="70.0" prefWidth="171.0" style="            -fx-font-size:20;            -fx-font-weight:bold;            -fx-text-fill:red;" wrapText="true" />






    <!-- TIMER -->

    <ImageView fx:id="timerPanelImage" fitHeight="136.0" fitWidth="248.0" layoutX="14.0" layoutY="117.0" preserveRatio="true" />

   

       <Label fx:id="timerLabel" alignment="CENTER" layoutX="90.0" layoutY="164.0" prefHeight="43.0" prefWidth="97.0" style="            -fx-font-size:30;            -fx-font-weight:bold;            -fx-text-fill:#4A2B08;" text="02:00" />



    <!-- MAIN GAME PANEL -->
    <AnchorPane layoutX="255.0" layoutY="119.0" prefHeight="439.0" prefWidth="730.0" style="                 -fx-background-color: rgba(255,255,255,0.75);                 -fx-background-radius:25;                 -fx-border-color:#6D4620;                 -fx-border-width:5;                 -fx-border-radius:25;">



        <!-- WORD -->
        <Label fx:id="wordLabel" alignment="CENTER" layoutX="26.0" layoutY="335.0" prefHeight="62.0" prefWidth="365.0" style="                -fx-font-size:42;                -fx-font-weight:bold;                -fx-text-fill:#3B2200;" textFill="#191616">

            <font>
                <Font size="42" />
            </font>

        </Label>



        <!-- HANGMAN IMAGE -->
<ImageView fx:id="hangmanImageView" fitHeight="350" fitWidth="300" layoutX="399.0" layoutY="45.0" preserveRatio="true" />
   
   

 
   
   
       <!-- HINT IMAGE BUTTON -->
   
       <ImageView fx:id="hintButtonImage" fitHeight="110" fitWidth="150" layoutX="75.0" layoutY="55.0" pickOnBounds="true" preserveRatio="true" visible="false" />



    </AnchorPane>





     <!-- WRONG LETTER PANEL -->

     <ImageView fx:id="wrongLettersPanelImage" fitHeight="159.0" fitWidth="216.0" layoutX="21.0" layoutY="322.0" preserveRatio="true" />


   
           <Label fx:id="wrongLettersLabel" alignment="CENTER" layoutX="18.0" layoutY="355.0" prefHeight="90.0" prefWidth="200.0" style="                -fx-font-size:20;                -fx-font-weight:bold;                -fx-text-fill:#B00000;" wrapText="true" />

   
   
   
   
   
       <!-- RESTART IMAGE BUTTON -->

       <ImageView fx:id="restartButton" fitHeight="111.0" fitWidth="215.0" layoutX="1044.0" layoutY="252.0" pickOnBounds="true" preserveRatio="true" />

 
   
   
   
   
   
       <!-- RESULT PANEL -->
            <ImageView fx:id="resultPanelImage" fitHeight="300.0" fitWidth="400.0" layoutX="450.0" layoutY="200.0" preserveRatio="true" visible="false" />
               <Label fx:id="resultLabel" alignment="CENTER" layoutX="450.0" layoutY="200.0" prefHeight="300.0" prefWidth="400.0" style="                -fx-font-size:24;                -fx-font-weight:bold;                -fx-text-fill:#4A2B08;" wrapText="true" />
    <!-- TITLE -->
    <ImageView fx:id="titleImage" fitHeight="201.0" fitWidth="864.0" layoutX="442.0" layoutY="15.0" preserveRatio="true" />

               <Button fx:id="musicButton" layoutX="1220.0" layoutY="20.0" onAction="#toggleMusic" prefHeight="45.0" prefWidth="45.0" text="🔊" />

         
         <Label fx:id="categoryLabel" alignment="CENTER" layoutX="270.0" layoutY="133.0" prefWidth="365.0" style="-fx-font-size:22;            -fx-font-weight:bold;            -fx-text-fill:#3B2200;" text="Category" textFill="#720c0c" />

                  <Label fx:id="playerNameLabel" layoutX="748.0" layoutY="133.0" prefWidth="220" style="-fx-font-size:22;               -fx-font-weight:bold;               -fx-text-fill:#5B2D0B;" text="Player: Guest" />

                  <!-- ========================= -->
<!-- ========================= -->
<!-- GAME OVERLAY -->
<!-- ========================= -->
<!-- ========================= -->
<!-- GAME OVERLAY -->
<!-- ========================= -->

<AnchorPane fx:id="overlayPane" layoutX="0" layoutY="0" prefHeight="800" prefWidth="1300" style="-fx-background-color: rgba(0,0,0,0.60);" visible="false">

    <!-- Overlay Background -->
    <ImageView fx:id="overlayImage" fitHeight="900" fitWidth="900" layoutX="200" layoutY="-20" preserveRatio="true" />

    <!-- Overlay Message -->
    <Label fx:id="overlayInfo" alignment="CENTER" layoutX="420" layoutY="340" prefHeight="140" prefWidth="460" style="-fx-font-size:28;                   -fx-font-weight:bold;                   -fx-text-fill:#4A2B08;" wrapText="true" />

    <!-- Continue -->
    <ImageView fx:id="continueButtonImage" fitHeight="95" fitWidth="260" layoutX="520" layoutY="495" pickOnBounds="true" preserveRatio="true" visible="false" />

    <!-- Play Again -->
    <ImageView fx:id="playAgainButtonImage" fitHeight="95" fitWidth="260" layoutX="520" layoutY="495" pickOnBounds="true" preserveRatio="true" visible="false" />

    <!-- Restart (Confirmation YES) -->
    <ImageView fx:id="restartOverlayButtonImage" fitHeight="95" fitWidth="260" layoutX="520" layoutY="495" pickOnBounds="true" preserveRatio="true" visible="false" />

    <!-- Leave Town -->
    <ImageView fx:id="leaveTownButtonImage" fitHeight="95" fitWidth="260" layoutX="520" layoutY="605" pickOnBounds="true" preserveRatio="true" visible="false" />

</AnchorPane>

<ImageView fx:id="quitButtonImage" fitHeight="126.0" fitWidth="226.0" layoutX="1040" layoutY="117.0" pickOnBounds="true" preserveRatio="true" />
</AnchorPane>
