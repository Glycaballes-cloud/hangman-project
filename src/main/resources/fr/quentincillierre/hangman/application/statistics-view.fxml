<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefWidth="1300"
            prefHeight="800"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.quentincillierre.hangman.controller.StatisticsController">

    <!-- Background -->
    <ImageView fx:id="backgroundImage"
               fitWidth="1300"
               fitHeight="800"
               preserveRatio="false"/>

    <!-- Title -->
    <Label layoutX="430"
           layoutY="40"
           text="SHERIFF'S RECORDS"
           style="-fx-font-size:40;
                  -fx-font-weight:bold;
                  -fx-text-fill:#5B2D0B;"/>

    <Label fx:id="playerLabel"
           layoutX="420"
           layoutY="140"
           style="-fx-font-size:24;" />

    <Label fx:id="gamesLabel"
           layoutX="420"
           layoutY="190"
           style="-fx-font-size:24;" />

    <Label fx:id="winsLabel"
           layoutX="420"
           layoutY="240"
           style="-fx-font-size:24;" />

    <Label fx:id="lossesLabel"
           layoutX="420"
           layoutY="290"
           style="-fx-font-size:24;" />

    <Label fx:id="winRateLabel"
           layoutX="420"
           layoutY="340"
           style="-fx-font-size:24;" />

    <Label fx:id="bestTimeLabel"
           layoutX="420"
           layoutY="390"
           style="-fx-font-size:24;" />

    <Label fx:id="hintsLabel"
           layoutX="420"
           layoutY="440"
           style="-fx-font-size:24;" />

    <Button fx:id="backButton"
            text="BACK"
            layoutX="560"
            layoutY="600"
            prefWidth="180"
            prefHeight="45"
            onAction="#goBack"/>

</AnchorPane>